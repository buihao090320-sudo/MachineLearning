   ],
   "source": [
    "import numpy as np\n",
    "import torch\n",
    "polynomial = np.poly1d([1, 2, 3])\n",
    "print(\"Hàm thật:\")\n",
    "print(\"Y = X² + 2X + 3\")\n",
    "N = 20\n",
    "X = np.random.randn(N, 1) * 5\n",
    "Y = polynomial(X)\n",
    "print(\"\\nSố lượng dữ liệu:\", N)\n",
    "XX = np.hstack([\n",
    "    X * X,\n",
    "    X,\n",
    "    np.ones_like(X)\n",
    "])\n",
    "print(\"\\nXX có 3 cột:\")\n",
    "print(\"Cột 1 = X²\")\n",
    "print(\"Cột 2 = X\")\n",
    "print(\"Cột 3 = 1\")\n",
    "w = torch.randn(3, 1, requires_grad=True)\n",
    "print(\"\\nHệ số ban đầu:\")\n",
    "print(w)\n",
    "x = torch.tensor(XX, dtype=torch.float32)\n",
    "y = torch.tensor(Y, dtype=torch.float32)\n",
    "optimizer = torch.optim.Adam([w], lr=0.01)\n",
    "for epoch in range(1000):\n",
    "    optimizer.zero_grad()\n",
    "    y_pred = x @ w\n",
    "    mse = torch.mean(torch.square(y - y_pred))\n",
    "    mse.backward()\n",
    "    optimizer.step()\n",
    "    if epoch % 100 == 0:\n",
    "        print(\n",
    "            f\"Epoch {epoch}: \"\n",
    "            f\"MSE = {mse.item():.6f}\"\n",
    "        )\n",
    "print(\"\\nHệ số học được:\")\n",
    "print(w)\n",
    "\n",
    "print(\"\\nHệ số thật:\")\n",
    "print(\"[1, 2, 3]\")"
   ]
  },
